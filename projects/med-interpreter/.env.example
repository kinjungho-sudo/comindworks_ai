# OpenAI — 받아쓰기·번역·음성
OPENAI_API_KEY=
# Supabase (서버 전용 secret key. 브라우저로 나가지 않음)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# 쿠키 서명용 임의 문자열 (openssl rand -hex 32)
APP_SECRET=
# 관리자 화면 PIN
ADMIN_PIN=
# Vercel Cron 인증
CRON_SECRET=
STT_MODEL=gpt-live-transcribe
STT_FALLBACK_MODEL=gpt-4o-transcribe
TRANSLATE_MODEL=gpt-5.4-mini
TTS_MODEL=gpt-4o-mini-tts
# Supabase 공개 키 (브라우저 실시간 채널용, 공개돼도 되는 키)
SUPABASE_PUBLISHABLE_KEY=
